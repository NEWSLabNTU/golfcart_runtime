#!/bin/bash
# Golf Cart Launch Script
# Generated during build with proper paths
# This script is called by the systemd service

set -e

# Configuration from CMake
WORKSPACE_DIR="@CMAKE_INSTALL_PREFIX@/../.."
ROS_DISTRO="@ROS_DISTRO@"

# Set up environment
export RCUTILS_COLORIZED_OUTPUT=1
export RCUTILS_LOGGING_USE_STDOUT=1

# Change to workspace directory
cd "$WORKSPACE_DIR"

# Source Autoware environment (includes ROS setup)
source /opt/autoware/autoware-env

# Source workspace
source "${WORKSPACE_DIR}/install/setup.bash"

# Log startup
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting Golf Cart system..."
echo "Workspace: $WORKSPACE_DIR"
echo "ROS Distribution: $ROS_DISTRO"
echo "System monitor available at: http://localhost:8080/"

# Launch the system
exec ros2 launch golfcart_launch golfcart.launch.yaml