[Unit]
Description=Golf Cart Autonomous Vehicle System
Documentation=https://github.com/NEWSLabNTU/2026-golf-cart
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=AUTOWARE_HOME=/opt/autoware
# RMW_IMPLEMENTATION and CYCLONEDDS_URI are deliberately not set here. The launch
# script sources scripts/env.sh, which sets both and picks the CycloneDDS profile
# from config/cyclonedds/<profile>.xml. Setting the URI here would pin every
# start to one file and quietly defeat that.
WorkingDirectory=@GOLFCART_WORKSPACE@

# Disable network isolation for ROS 2 DDS discovery
PrivateNetwork=no
IPAddressDeny=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
PrivateDevices=no

# Main execution - call the generated launch script
ExecStart=@GOLFCART_WORKSPACE@/install/golfcart_runtime/share/golfcart_runtime/scripts/golfcart-launch.sh

# Restart policy
Restart=on-failure
RestartSec=10s
StartLimitInterval=300s
StartLimitBurst=5

# Process management
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=120s
TimeoutStopSec=30s

# Logging
StandardOutput=journal+console
StandardError=journal+console
SyslogIdentifier=golfcart

[Install]
WantedBy=default.target