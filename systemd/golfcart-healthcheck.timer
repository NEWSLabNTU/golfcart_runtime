[Unit]
Description=Golf Cart Health Check Timer
Documentation=https://github.com/NEWSLabNTU/2026-golf-cart
Requires=golfcart@%i.service

[Timer]
# Run health check every 5 minutes
OnCalendar=*:0/5
Persistent=true

# Randomize execution time by up to 30 seconds to avoid system load spikes
RandomizedDelaySec=30s

# Ensure we don't accumulate missed runs
AccuracySec=1s

[Install]
WantedBy=timers.target